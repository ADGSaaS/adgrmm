  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id          String   @db.Uuid
  source            String
  app_id            String
  name              String
  installed_version String?
  available_version String
  approximate       Boolean  @default(false)
  first_seen_at     DateTime @default(now()) @db.Timestamptz(6)
  scanned_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([agent_id, source, app_id], map: "agent_outdated_software_uq")
}

/// The last outdated-software scan of a device: when it answered, what each tool said, and why not when it failed.
model agent_software_scans {
  agent_id     String    @id @db.Uuid
  attempted_at DateTime  @default(now()) @db.Timestamptz(6)
  scanned_at   DateTime? @db.Timestamptz(6)
  ok           Boolean   @default(false)
  winget_state String?
  choco_state  String?
  message      String?
  app_count    Int       @default(0)
}

/// "Allowed to update on its own" and "never update" by package id, for the whole organisation or one customer.
model software_update_rules {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  client_id       String?  @db.Uuid
  source          String   @default("winget")
  app_id          String
  app_name        String?
  rule            String
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, rule], map: "software_update_rules_org_idx")
}

model device_registry_changes {
