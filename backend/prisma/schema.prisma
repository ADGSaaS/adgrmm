generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agent_software {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id          String    @db.Uuid
  name              String
  publisher         String?
  version           String?
  install_location  String?
  install_date      DateTime? @db.Timestamptz(6)
  uninstall_command String?
  /// "machine" for a program installed for every user, "user" for one installed under a single user's profile.
  scope             String    @default("machine")
  /// For a user-scope program, the account whose profile holds it.
  installed_user    String?
  /// Best effort: who ran the installer.
  installed_by      String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  agents            agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_id], map: "idx_agent_software_agent")
  @@index([name], map: "idx_agent_software_name")
}

model agent_task_results {
  run_id          String          @id @db.Uuid
  stdout          String?
  stderr          String?
  artifacts       Json?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  agent_task_runs agent_task_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model agent_task_runs {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id            String              @db.Uuid
  attempt            Int                 @default(1)
  status             agent_task_status
  started_at         DateTime            @default(now()) @db.Timestamptz(6)
  finished_at        DateTime?           @db.Timestamptz(6)
  output             Json?
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  agent_task_results agent_task_results?
  agent_tasks        agent_tasks         @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  automation_runs    automation_runs[]

  @@index([task_id], map: "idx_agent_task_runs_task")
}

model agent_tasks {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id        String            @db.Uuid
  type            agent_task_type
  payload         Json
  status          agent_task_status @default(pending)
  queued_at       DateTime?         @db.Timestamptz(6)
  started_at      DateTime?         @db.Timestamptz(6)
  completed_at    DateTime?         @db.Timestamptz(6)
  created_by      String?           @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  agent_task_runs agent_task_runs[]
  agents          agents            @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?            @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([agent_id, status], map: "idx_agent_tasks_agent_status")
}

model agents {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_id        String           @unique @db.Uuid
  agent_uuid       String           @unique
  version          String
  last_check_in_at DateTime?        @db.Timestamptz(6)
  facts            Json             @default("{}")
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  token            String?
  agent_token      String?
  hostname         String?
  version_changed_at DateTime?      @db.Timestamptz(6)
  agent_software   agent_software[]
  agent_tasks      agent_tasks[]
  agent_user_accounts agent_user_accounts[]
  devices          devices          @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs             jobs[]
}

model automation_runs {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automation_id   String            @db.Uuid
  task_run_id     String?           @db.Uuid
  triggered_by    String?           @db.Uuid
  status          agent_task_status
  started_at      DateTime          @default(now()) @db.Timestamptz(6)
  finished_at     DateTime?         @db.Timestamptz(6)
  output          Json?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  automations     automations       @relation(fields: [automation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent_task_runs agent_task_runs?  @relation(fields: [task_run_id], references: [id], onUpdate: NoAction)
  users           users?            @relation(fields: [triggered_by], references: [id], onUpdate: NoAction)
}

model automations {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  name            String
  type            agent_task_type
  description     String?
  script          String?
  configuration   Json              @default("{}")
  created_by      String?           @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  automation_runs automation_runs[]
  script_runs     script_runs[]
  script_schedules script_schedules[]
  users           users?            @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model backup_destinations {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id            String                       @db.Uuid
  name                       String
  provider                   String
  configuration              Json
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  organizations              organizations                @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  backup_job_destinations    backup_job_destinations[]
  backup_policies            backup_policies[]
  backup_policy_destinations backup_policy_destinations[]
  backup_run_destinations    backup_run_destinations[]

  @@unique([organization_id, name])
}

model backup_job_artifacts {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backup_job_id    String      @db.Uuid
  artifact_type    String
  storage_location String
  size_bytes       BigInt?
  checksum         String?
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  backup_jobs      backup_jobs @relation(fields: [backup_job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model backup_job_destinations {
  job_id              String              @db.Uuid
  destination_id      String              @db.Uuid
  is_primary          Boolean             @default(false)
  priority            Int                 @default(100)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  backup_destinations backup_destinations @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  backup_jobs         backup_jobs         @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([job_id, destination_id])
  @@index([destination_id], map: "idx_bjd_dest")
  @@index([job_id], map: "idx_bjd_job")
}

model backup_job_logs {
  job_id      String      @id @db.Uuid
  log_text    String      @default("")
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  backup_jobs backup_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model backup_job_manifests {
  job_id      String      @id @db.Uuid
  manifest    Json        @default("{}")
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  backup_jobs backup_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model backup_jobs {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policy_id               String?                   @db.Uuid
  status                  backup_status
  note                    String?
  size_bytes              BigInt?
  duration_sec            Int?
  verified                Boolean?
  cancelled               Boolean                   @default(false)
  artifact_location       Json?
  started_at              DateTime                  @default(now()) @db.Timestamptz(6)
  finished_at             DateTime?                 @db.Timestamptz(6)
  error                   String?
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  min_success             Int                       @default(1)
  parallelism             Int                       @default(2)
  archive_name            String?
  checksum                String?
  backup_kind             String                    @default("logical")
  config_snapshot         Json                      @default("{}")
  backup_job_artifacts    backup_job_artifacts[]
  backup_job_destinations backup_job_destinations[]
  backup_job_logs         backup_job_logs?
  backup_job_manifests    backup_job_manifests?
  backup_policies         backup_policies?          @relation(fields: [policy_id], references: [id], onUpdate: NoAction)
  backup_restores         backup_restores[]
  backup_run_destinations backup_run_destinations[]

  @@index([policy_id, started_at(sort: Desc)], map: "idx_backup_jobs_policy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model backup_policies {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id            String                       @db.Uuid
  name                       String
  description                String?
  schedule                   String
  retention                  Json
  destination_id             String?                      @db.Uuid
  target_type                check_target_type
  target_id                  String?                      @db.Uuid
  created_by                 String?                      @db.Uuid
  options                    Json                         @default("{}")
  is_default                 Boolean                      @default(false)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  backup_kind                String                       @default("logical")
  backup_jobs                backup_jobs[]
  users                      users?                       @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  backup_destinations        backup_destinations?         @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  organizations              organizations                @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  backup_policy_destinations backup_policy_destinations[]

  @@unique([organization_id, name])
}

model backup_policy_destinations {
  policy_id           String              @db.Uuid
  destination_id      String              @db.Uuid
  is_primary          Boolean             @default(false)
  priority            Int                 @default(100)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  backup_destinations backup_destinations @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  backup_policies     backup_policies     @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([policy_id, destination_id])
}

model backup_restores {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backup_job_id    String        @db.Uuid
  requested_by     String?       @db.Uuid
  requested_at     DateTime      @default(now()) @db.Timestamptz(6)
  status           backup_status
  notes            String?
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @db.Timestamptz(6)
  finished_at      DateTime?     @db.Timestamptz(6)
  error            String?
  restore_database String?
  verification     Json          @default("{}")
  backup_jobs      backup_jobs   @relation(fields: [backup_job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?        @relation(fields: [requested_by], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model backup_run_destinations {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id              String              @db.Uuid
  destination_id      String              @db.Uuid
  status              String              @default("pending")
  phases              Json                @default("{}")
  error               String?
  remote_path         String?
  size_bytes          BigInt?
  etag                String?
  checksum            String?
  finished_at         DateTime?           @db.Timestamptz(6)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  backup_destinations backup_destinations @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  backup_jobs         backup_jobs         @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([destination_id], map: "idx_brd_dest")
  @@index([job_id], map: "idx_brd_job")
  @@index([status], map: "idx_brd_status")
}

model backups_config {
  id                String    @id @default("singleton")
  enabled           Boolean   @default(false)
  targets           Json      @default("[]")
  schedule          String    @default("daily")
  cron_expr         String?
  retention_days    Int       @default(30)
  encrypt           Boolean   @default(true)
  destination       Json      @default("{}")
  notifications     Json      @default("{}")
  last_scheduled_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
}

model branding_settings {
  id                        Int      @id
  primary_color             String?
  secondary_color           String?
  logo_light_url            String?
  logo_dark_url             String?
  login_background_url      String?
  favicon_url               String?
  email_header              String?
  email_footer              String?
  custom_css                String?
  allow_client_theme_toggle Boolean?
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model canned_responses {
  id              String   @id @db.Uuid
  organization_id String   @db.Uuid
  title           String
  body            String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id], map: "canned_responses_org_idx")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model canned_variables {
  id              String   @id @db.Uuid
  organization_id String   @db.Uuid
  key             String
  value           String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id], map: "canned_variables_org_idx")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model check_assignments {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  check_id    String?      @db.Uuid
  target_type String?
  target_id   String?      @db.Uuid
  created_by  String?      @db.Uuid
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  device_id   String?
  dedupe_key  String?
  check_type  String?
  check_name  String?
  checks      checks?      @relation(fields: [check_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?       @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  check_runs  check_runs[]

  @@unique([target_type, target_id, dedupe_key], map: "check_assignments_target_dedupe_uk")
  @@index([device_id])
  @@index([target_type, target_id], map: "check_assignments_target_idx")
  @@index([target_type, target_id], map: "idx_check_assignments_target")
}

model check_profile_members {
  profile_id     String         @db.Uuid
  check_id       String         @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  checks         checks         @relation(fields: [check_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  check_profiles check_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([profile_id, check_id])
}

/// A policy kept as a pattern. It is never applied to anything; people copy it to a global, customer, site or tag policy and edit that.
model policy_templates {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String
  description     String?
  priority        Int           @default(100)
  os              String        @default("any")
  enforced        Boolean       @default(false)
  sections        Json          @default("{}")
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

/// The catalog policies pick software from, and the installer details used to put it on endpoints.
/// The accounts a device has, reported with its software inventory, so a person can pick which user to install for.
model agent_user_accounts {
  agent_id   String   @db.Uuid
  account    String
  logged_in  Boolean  @default(false)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  agents     agents   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([agent_id, account])
}

model software_library {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String        @db.Uuid
  name             String
  category         String        @default("Other")
  match_text       String
  publisher        String?
  chocolatey_id    String?
  chocolatey_params       String?
  chocolatey_install_args String?
  winget_id        String?
  installer_url    String?
  installer_sha256 String?
  installer_kind   String?
  silent_args      String?
  linux_package    String?
  notes            String?
  built_in         Boolean       @default(false)
  created_by       String?       @db.Uuid
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @db.Timestamptz(6)
  organizations    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model check_profiles {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String                  @db.Uuid
  name                  String
  description           String?
  created_by            String?                 @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  check_profile_members check_profile_members[]
  users                 users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organizations         organizations           @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model check_runs {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id     String            @db.Uuid
  status            String
  severity          String?
  started_at        DateTime          @default(now()) @db.Timestamptz(6)
  finished_at       DateTime?         @db.Timestamptz(6)
  metrics           Json?
  output            String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  device_id         String?
  check_assignments check_assignments @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignment_id])
  @@index([created_at])
  @@index([device_id])
  @@index([assignment_id, started_at(sort: Desc)], map: "idx_check_runs_assignment")
}

model checks {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String                  @db.Uuid
  name                  String
  type                  check_type
  category              String?
  description           String?
  schedule              String
  config                Json
  created_by            String?                 @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  enabled               Boolean                 @default(true)
  check_assignments     check_assignments[]
  check_profile_members check_profile_members[]
  users                 users?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organizations         organizations           @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model clients {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String                 @db.Uuid
  name                 String
  external_ref         String?
  contact              Json                   @default("{}")
  remote_console_consent String               @default("notice")
  record_remote_sessions Boolean              @default(false)
  remote_console_codec String                 @default("auto")
  default_update_ring  String                 @default("stable")
  status               String                 @default("active")
  legal_name           String?
  industry             String?
  website              String?
  phone                String?
  email                String?
  billing_email        String?
  tax_id               String?
  time_zone            String?
  currency             String?
  payment_terms        String?
  employee_count       Int?
  customer_since       DateTime?              @db.Date
  address              Json                   @default("{}")
  billing_address      Json                   @default("{}")
  billing_same_as_address Boolean             @default(true)
  notes                String?
  tags                 String[]               @default([])
  /// Values of the custom fields the organization defines, by field key.
  custom_fields        Json                   @default("{}")
  customer_contacts    customer_contacts[]
  archived_at          DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  endpoint_enrollments endpoint_enrollments[]
  site_enrollment_keys site_enrollment_keys[]
  sites                sites[]

  contracts    contracts[]
  invoices     invoices[]
  time_entries time_entries[]
  assets      assets[]
  report_schedules report_schedules[]
  @@unique([organization_id, name])
}

model company_profile {
  id         Int     @id
  name       String
  legal_name String?
  email      String?
  phone      String?
  fax        String?
  website    String?
  vat_tin    String?
  address1   String?
  address2   String?
  city       String?
  state      String?
  postal     String?
  country    String?
}

model contacts {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String
  email           String?       @db.Citext
  phone           String?
  metadata        Json          @default("{}")
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tickets         tickets[]
}

model device_deletion_requests {
  id                   String    @id @db.Uuid
  device_id            String    @unique @db.Uuid
  status               String
  requested_by_user_id String?   @db.Uuid
  requested_at         DateTime  @default(now()) @db.Timestamptz(6)
  approved_by_user_id  String?   @db.Uuid
  approved_at          DateTime? @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)
  /// Why the person asked for the device to be removed.
  reason               String?
  /// The ticket opened for the approval, when the person asked for one.
  ticket_id            String?   @db.Uuid

  @@index([status])
