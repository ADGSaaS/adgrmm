/// A visit booked against a ticket: when, where, who goes, and how far along it is. Foreign keys are in the migration.
model ticket_visits {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String               @db.Uuid
  ticket_id            String               @db.Uuid
  client_id            String?              @db.Uuid
  title                String
  notes                String?
  location             String?
  status               String               @default("scheduled")
  starts_at            DateTime             @db.Timestamptz(6)
  ends_at              DateTime             @db.Timestamptz(6)
  time_zone            String               @default("UTC")
  customer_notified_at DateTime?            @db.Timestamptz(6)
  time_entry_id        String?              @db.Uuid
  sequence             Int                  @default(0)
  created_by           String?              @db.Uuid
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  techs                ticket_visit_techs[]

  @@index([organization_id, starts_at])
  @@index([ticket_id])
}

model ticket_visit_techs {
  visit_id String        @db.Uuid
  user_id  String        @db.Uuid
  visit    ticket_visits @relation(fields: [visit_id], references: [id], onDelete: Cascade)

  @@id([visit_id, user_id])
  @@index([user_id])
}

/// A technician's weekly working hours (Monday..Sunday) in their own time zone.
model tech_availability {
  user_id         String   @id @db.Uuid
  organization_id String   @db.Uuid
  time_zone       String   @default("UTC")
  hours           Json     @default("[]")
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
}

model tech_time_off {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  starts_at       DateTime @db.Timestamptz(6)
  ends_at         DateTime @db.Timestamptz(6)
  reason          String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, starts_at])
