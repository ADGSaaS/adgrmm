/// A device on a ticket. A ticket can have none, one or several, all of the ticket's customer.
model ticket_devices {
  ticket_id String   @db.Uuid
  device_id String   @db.Uuid
  added_by  String?
  added_at  DateTime @default(now()) @db.Timestamptz(6)
  tickets   tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  devices   devices  @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([ticket_id, device_id])
  @@index([device_id])
}

/// A ticket made from a template on a schedule. Foreign keys are in the migration.
model recurring_tickets {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String    @db.Uuid
  name             String
  template_id      String?   @db.Uuid
  subject          String?
  description      String?
  priority         String?
  client_id        String    @db.Uuid
  site_id          String?   @db.Uuid
  device_id        String?   @db.Uuid
  assignee_user_id String?   @db.Uuid
  frequency        String
  run_time         String    @default("08:00")
  timezone         String    @default("UTC")
  days_of_week     Int[]     @default([])
  day_of_month     Int?
  month_of_year    Int?
  start_date       DateTime? @db.Date
  end_date         DateTime? @db.Date
  skip_if_open     Boolean   @default(true)
  enabled          Boolean   @default(true)
  next_run_at      DateTime? @db.Timestamptz(6)
  last_run_at      DateTime? @db.Timestamptz(6)
  last_status      String?
  last_error       String?
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  runs             recurring_ticket_runs[]

  @@unique([organization_id, name])
}

/// One row per period a recurring schedule has run for; the unique run key stops a second ticket for the same period.
model recurring_ticket_runs {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurring_id  String            @db.Uuid
  run_key       String
  scheduled_for DateTime          @db.Timestamptz(6)
  trigger       String            @default("scheduled")
  status        String            @default("pending")
  ticket_id     String?           @db.Uuid
  error         String?
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  finished_at   DateTime?         @db.Timestamptz(6)
  recurring     recurring_tickets @relation(fields: [recurring_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recurring_id, run_key])
  @@index([recurring_id, created_at(sort: Desc)])
}

/// Customer satisfaction surveys: the settings of the organization.
model survey_settings {
  organization_id     String    @id @db.Uuid
  enabled             Boolean   @default(false)
  trigger_statuses    String[]  @default(["resolved", "closed"])
  delay_minutes       Int       @default(60)
  scope               String    @default("all")
  client_ids          String[]  @default([]) @db.Uuid
  throttle_days       Int       @default(14)
  reminder_enabled    Boolean   @default(false)
  reminder_after_days Int       @default(3)
  expiry_days         Int       @default(30)
  scale               String    @default("stars")
  low_threshold       Int       @default(2)
  alert_user_ids      String[]  @default([]) @db.Uuid
  alert_group_ids     String[]  @default([]) @db.Uuid
  enabled_at          DateTime? @db.Timestamptz(6)
  updated_by          String?   @db.Uuid
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
}

/// One survey per ticket: sent to the person who asked, answered once through a signed link or the portal.
model ticket_surveys {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String    @db.Uuid
  ticket_id          String    @unique @db.Uuid
  client_id          String?   @db.Uuid
  recipient_email    String    @default("")
  recipient_name     String    @default("")
  technician_user_id String?   @db.Uuid
  status             String    @default("pending")
  skip_reason        String?
  attempts           Int       @default(0)
  next_attempt_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_error         String?
  portal_link        Boolean   @default(false)
  triggered_at       DateTime? @db.Timestamptz(6)
  sent_at            DateTime? @db.Timestamptz(6)
  reminded_at        DateTime? @db.Timestamptz(6)
  expires_at         DateTime? @db.Timestamptz(6)
  answered_at        DateTime? @db.Timestamptz(6)
  answered_via       String?
  score              Int?
  comment            String?
  low_alerted_at     DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, next_attempt_at])
  @@index([organization_id, answered_at])
}

/// Working hours for SLA clocks: a time zone, working days and hours, and holidays. A policy with none runs around the clock.
model sla_calendars {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  timezone        String   @default("UTC")
  days            Int[]    @default([1, 2, 3, 4, 5])
  start_time      String   @default("09:00")
  end_time        String   @default("17:00")
  holidays        Json     @default("[]")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
}

/// Response and resolution targets by priority, which statuses stop the clocks, and what happens on a warning or breach.
model sla_policies {
