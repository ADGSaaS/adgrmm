  pause_statuses  String[] @default(["pending"])
  warn_percent    Int      @default(80)
  escalation      Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
}

model sla_client_policies {
  client_id  String   @id @db.Uuid
  policy_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// Where tickets wait for someone, and who gets them.
model ticket_queues {
