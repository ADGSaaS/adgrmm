}

/// Software a customer must have, or must not have, by part of the program's name. A row with no customer applies to all.
model software_policies {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  client_id       String?  @db.Uuid
  kind            String
  pattern         String
  note            String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, client_id])
}

/// When the working day is, for availability measured in business hours only.
model report_settings {
  organization_id String   @id @db.Uuid
  business_days   Int[]    @default([1, 2, 3, 4, 5])
  business_start  String   @default("08:00")
  business_end    String   @default("18:00")
  timezone        String   @default("UTC")
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
}

/// A customer's own look for the reports sent to them: colour, logo, a note on the cover and a footer on every page.
/// The people at a customer: who to call, who gets the invoice, who looks after the technology.
model customer_contacts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id  String   @db.Uuid
  name       String
  job_title  String?
  email      String?
  phone      String?
  mobile     String?
  role       String   @default("other")
  is_primary Boolean  @default(false)
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  clients    clients  @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id])
}

model client_report_settings {
  client_id     String   @id @db.Uuid
  primary_color String?
  logo_file     String?
  cover_text    String?
  footer_text   String?
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

/// Every time a scheduled report was sent or tried, kept after the schedule is gone.
model report_deliveries {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id    String?  @db.Uuid
  schedule_label String?
  report_key     String
  ran_at         DateTime @default(now()) @db.Timestamptz(6)
  trigger        String
  ok             Boolean
  recipients     String
  subject        String?
  attachments    String?
  result         String?
  error          String?

  @@index([schedule_id, ran_at(sort: Desc)])
  @@index([ran_at(sort: Desc)])
}

/// People who may only see some customers. A person with no rows here sees all of them.
model user_client_access {
  user_id    String   @db.Uuid
  client_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([user_id, client_id])
  @@index([client_id])
}

/// A named bundle of settings that applies to a customer, site, device or everyone. See docs/design/POLICIES.md.
model policies {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String               @db.Uuid
  name            String
  description     String?
  enabled         Boolean              @default(true)
  priority        Int                  @default(100)
  os              String               @default("any")
  enforced        Boolean              @default(false)
  apply_to_new_customers Boolean       @default(false)
  sections        Json                 @default("{}")
  version         Int                  @default(1)
  created_by      String?              @db.Uuid
  created_at      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at      DateTime             @default(now()) @db.Timestamptz(6)
  organizations   organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignments     policy_assignments[]

  @@unique([organization_id, name])
}

/// Where a policy applies, or where it is switched off (exclude).
model policy_assignments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policy_id  String   @db.Uuid
  level      String
  target_id  String?  @db.Uuid
  exclude    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  policies   policies @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([policy_id])
  @@index([level, target_id])
}

/// Every change to a policy, kept after the policy is gone, so a change can be seen and undone.
model policy_audit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  policy_id       String?  @db.Uuid
  policy_name     String
  action          String
  actor_id        String?  @db.Uuid
  actor_name      String?
  version         Int?
  before          Json?
  after           Json?
  at              DateTime @default(now()) @db.Timestamptz(6)

  @@index([policy_id, at(sort: Desc)])
  @@index([organization_id, at(sort: Desc)])
}

/// What policies did on their own: patches started, restarts requested. Also keeps each from repeating too soon.
model policy_actions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  device_id       String   @db.Uuid
  policy_id       String?  @db.Uuid
  policy_name     String?
  kind            String
  detail          Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([device_id, kind, created_at(sort: Desc)])
  @@index([organization_id, created_at(sort: Desc)])
}

/// A label that can be put on devices, so a policy can reach "all servers" without naming each one.
model tag_defs {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String
  color           String?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  device_tags     device_tags[]

  @@unique([organization_id, name])
}

model device_tags {
  device_id  String   @db.Uuid
  tag_id     String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  devices    devices  @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag_defs   tag_defs @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([device_id, tag_id])
  @@index([tag_id])
}

/// A check that has started failing but has not lasted long enough to raise an alert yet.
model alert_pending {
  dedupe_key    String   @id
  device_id     String   @db.Uuid
  first_seen_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([last_seen_at])
}

model user_groups {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                   @db.Uuid
  name                   String
  description            String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  organizations          organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_group_members     user_group_members[]
  user_group_permissions user_group_permissions[]
  user_group_scope       user_group_scope[]

  @@unique([organization_id, name])
}

model user_group_members {
  group_id    String      @db.Uuid
  user_id     String      @db.Uuid
  added_at    DateTime    @default(now()) @db.Timestamptz(6)
  user_groups user_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
  @@index([user_id])
}

model user_group_permissions {
  group_id       String      @db.Uuid
  permission_key String
  user_groups    user_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissions    permissions @relation(fields: [permission_key], references: [permission_key], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, permission_key])
}

model user_group_scope {
  group_id    String      @db.Uuid
  kind        String
  target_id   String      @db.Uuid
  user_groups user_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, kind, target_id])
}

/// The Microsoft 365 mailbox that support mail is read from and replies are sent from.
model support_mailbox {
  organization_id     String        @id @db.Uuid
  enabled             Boolean       @default(false)
  source              String        @default("microsoft")
  tenant_id           String        @default("")
  client_id           String        @default("")
  client_secret       String?
  refresh_token       String?
  mailbox_address     String        @default("")
  connected_at        DateTime?     @db.Timestamptz(6)
  oauth_state         String?
  oauth_state_expires DateTime?     @db.Timestamptz(6)
  oauth_return_to     String?
  last_polled_at      DateTime?     @db.Timestamptz(6)
  last_error          String?
  last_error_at       DateTime?     @db.Timestamptz(6)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @default(now()) @db.Timestamptz(6)
  organizations       organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// A piece of script kept for reuse: private to its writer, or shared with everyone who writes scripts.
model script_snippets {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  owner_user_id   String?  @db.Uuid
  title           String
  description     String?
  language        String   @default("any")
  body            String
  is_shared       Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id])
}

/// Single sign-on through an OpenID Connect provider.
model sso_config {
  organization_id String   @id @db.Uuid
  enabled         Boolean  @default(false)
  display_name    String   @default("Single sign-on")
  issuer          String   @default("")
  client_id       String   @default("")
  client_secret   String?
  scopes          String   @default("openid email profile")
  jit_enabled     Boolean  @default(false)
  default_role_id String?  @db.Uuid
  allowed_domains String   @default("")
  password_login  Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
}

/// Which provider account belongs to which user.
model sso_identities {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  issuer          String
  subject         String
  email           String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  last_login_at   DateTime? @db.Timestamptz(6)

  @@unique([issuer, subject])
  @@unique([user_id, issuer])
}

/// A sign-in in progress, kept for a few minutes.
model sso_login_states {
  state           String   @id
  organization_id String   @db.Uuid
  nonce           String
  code_verifier   String
  return_to       String?
  expires_at      DateTime @db.Timestamptz(6)

  @@index([expires_at])
}

/// An import from another helpdesk: preview, then run.
model import_jobs {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  source          String
  status          String
  config          Json      @default("{}")
  options         Json      @default("{}")
  preview         Json?
  progress        Json      @default("{}")
  errors          Json      @default("[]")
  message         String?
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  started_at      DateTime? @db.Timestamptz(6)
  finished_at     DateTime? @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organization_id, created_at(sort: Desc)])
}

/// Which imported thing became which record here.
model import_links {
  organization_id String   @db.Uuid
  source          String
  kind            String
  external_id     String
  local_id        String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@id([organization_id, source, kind, external_id])
}

/// A field the organization keeps about its customers.
model custom_field_defs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  entity          String   @default("customer")
  key             String
  label           String
  type            String
  options         Json     @default("[]")
  required        Boolean  @default(false)
  help            String?
  sort_order      Int      @default(0)
  active          Boolean  @default(true)
  /// Ticket fields only: shown to the customer on their ticket in the client portal.
  visible_to_customer Boolean @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([organization_id, entity, key])
}

/// The client portal's settings: its own domain and what customers can open there.
model portal_settings {
  organization_id     String   @id @db.Uuid
  enabled             Boolean  @default(false)
  domain              String?
  modules             String[] @default(["dashboard", "tickets", "devices", "invoices", "reports"])
  allow_ticket_create Boolean  @default(true)
  welcome_title       String   @default("")
  welcome_text        String   @default("")
  support_email       String   @default("")
  support_phone       String   @default("")
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
}

/// A customer's person who can sign in to the portal.
model portal_accounts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  client_id       String    @db.Uuid
  contact_id      String?   @db.Uuid
  email           String    @db.Citext
  name            String
  role            String    @default("user")
  status          String    @default("invited")
  password_hash   String?
  failed_logins   Int       @default(0)
  locked_until    DateTime? @db.Timestamptz(6)
  last_login_at   DateTime? @db.Timestamptz(6)
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([email])
  @@index([client_id])
}

model portal_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String    @db.Uuid
  kind       String
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([account_id])
}

model portal_sessions {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String    @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  ip         String?
  user_agent String?

  @@index([account_id])
}

model portal_ticket_reads {
  account_id String   @db.Uuid
  ticket_id  String   @db.Uuid
  read_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([account_id, ticket_id])
}

model ticket_staff_reads {
  user_id   String   @db.Uuid
  ticket_id String   @db.Uuid
  read_at   DateTime @default(now()) @db.Timestamptz(6)

  @@id([user_id, ticket_id])
}

/// Administration > Security Policies: password rules, session limits, sign-in address list and CAPTCHA.
model security_policies {
  organization_id            String   @id @db.Uuid
  password_min_length        Int      @default(8)
  password_require_numbers   Boolean  @default(false)
  password_require_special   Boolean  @default(false)
  password_require_uppercase Boolean  @default(false)
  password_history           Int      @default(0)
  session_timeout_mins       Int      @default(0)
  idle_timeout_mins          Int      @default(0)
  ip_allowlist               String   @default("")
  captcha_enabled            Boolean  @default(false)
  turnstile_site_key         String   @default("")
  turnstile_secret           String?
  updated_at                 DateTime @default(now()) @db.Timestamptz(6)
  updated_by                 String?  @db.Uuid
}

/// Hashes of earlier staff passwords, for the "do not reuse" rule.
model password_history {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  password_hash String
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at(sort: Desc)], map: "password_history_user_idx")
}

/// Administration > Agents & Endpoints.
model agent_settings {
  organization_id         String   @id @db.Uuid
  install_key_expiry_mins Int      @default(10080)
  auto_update             Boolean  @default(true)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_by              String?  @db.Uuid
}

/// What an administrator changed about a feature flag. The flags and their defaults live in the code.
model feature_flags {
  organization_id String   @db.Uuid
  key             String
  enabled         Boolean
  updated_by      String?  @db.Uuid
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@id([organization_id, key])
}

/// A starting point for a new ticket: its subject, description, priority and custom field values.
model ticket_templates {
