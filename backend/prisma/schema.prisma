}

model kb_ticket_links {
  ticket_id  String      @db.Uuid
  article_id String      @db.Uuid
  linked_by  String?     @db.Uuid
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  article    kb_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@id([ticket_id, article_id])
  @@index([article_id])
