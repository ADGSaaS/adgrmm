model report_schedules {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  /// The customer a report covers. Empty means every customer, for the reports that can span them.
  client_id       String?       @db.Uuid
  /// "customer-health" (the original customer summary) or the key of an endpoint report.
  report_key      String        @default("customer-health")
  /// Scope, limits, period and the filter, sort, grouping and columns to send, copied from a saved view or set directly.
  config          Json          @default("{}")
  /// pdf, csv or both.
  format          String        @default("pdf")
  /// When false, a run with nothing to report sends nothing.
  send_if_empty   Boolean       @default(true)
  /// daily, weekly, monthly or once.
  frequency       String        @default("monthly")
  /// The time of day to send, 24 hour HH:MM, in the time zone below.
  time_of_day     String        @default("07:00")
  /// An IANA zone, so a customer's report arrives at their local time, daylight saving included.
  timezone        String        @default("UTC")
  /// Weekly: which days, 0 is Sunday.
  days_of_week    Int[]         @default([])
  /// Monthly: 1 to 31, or -1 for the last day.
  day_of_month    Int?
  /// Monthly, instead of a day: the first to fourth (or -1 last) weekday of the month.
  nth_week        Int?
  nth_weekday     Int?
  /// Once: the date, yyyy-mm-dd.
  once_date       String?
  recipients      String[]      @default([])
  enabled         Boolean       @default(true)
  next_run_at     DateTime      @db.Timestamptz(6)
  last_run_at     DateTime?     @db.Timestamptz(6)
  last_error      String?
  last_result     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  clients         clients?      @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([enabled, next_run_at])
}

