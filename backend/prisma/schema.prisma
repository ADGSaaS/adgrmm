/// Something done to many devices at once from the device list (reboot, patch scan, run a script, ...). One row per click.
model bulk_batches {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String             @db.Uuid
  action          String
  summary         String
  params          Json               @default("{}")
  requested       Int
  succeeded       Int                @default(0)
  skipped         Int                @default(0)
  failed          Int                @default(0)
  created_by      String?            @db.Uuid
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  items           bulk_batch_items[]

  @@index([organization_id, created_at(sort: Desc)], map: "bulk_batches_org_created_idx")
  @@index([created_by, created_at(sort: Desc)], map: "bulk_batches_user_created_idx")
}

/// What happened to one device in a batch: done or queued (with its job or task), skipped, or failed, and why.
model bulk_batch_items {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id    String       @db.Uuid
  device_id   String       @db.Uuid
  device_name String       @default("")
  client_id   String?      @db.Uuid
  status      String
  reason      String?
  job_id      String?      @db.Uuid
  task_id     String?      @db.Uuid
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  batch       bulk_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([batch_id], map: "bulk_batch_items_batch_idx")
}

/// A program with a newer version, as the last software_updates_scan of a device saw it (winget or Chocolatey).
