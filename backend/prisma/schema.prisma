/// The last security scan of a Windows device (see 20261119010000_device_security_scans): the checked probes in `raw`, and the score and counts as of that scan.
model device_security_scans {
  device_id       String    @id @db.Uuid
  scanned_at      DateTime? @db.Timestamptz(6)
  attempted_at    DateTime  @default(now()) @db.Timestamptz(6)
  ok              Boolean   @default(false)
  raw             Json?
  score           Int?
  grade           String?
  findings_failed Int       @default(0)
  findings_warned Int       @default(0)
  critical_failed Int       @default(0)
  high_failed     Int       @default(0)
  unknown_count   Int       @default(0)
  failed_rules    String[]  @default([])
  message         String?
  pending_job_id  String?   @db.Uuid
  pending_at      DateTime? @db.Timestamptz(6)

  @@index([score], map: "device_security_scans_score_idx")
  @@index([grade], map: "device_security_scans_grade_idx")
  @@index([attempted_at], map: "device_security_scans_attempted_idx")
}
/// The encrypted device-secrets vault (see 20261120010000_device_secrets). Accessed with raw SQL; ciphertext is never selected by listings.
model device_secrets {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id           String    @db.Uuid
  device_id        String    @db.Uuid
  kind             String
  label            String
  ref              String
  ciphertext       String?
  key_version      Int       @default(1)
  key_id           String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  rotated_at       DateTime? @db.Timestamptz(6)
  superseded_at    DateTime? @db.Timestamptz(6)
  last_seen_at     DateTime? @db.Timestamptz(6)
  missed_reads     Int       @default(0)
  status           String    @default("current")
  last_revealed_at DateTime? @db.Timestamptz(6)
  last_revealed_by String?

  @@index([device_id, kind, status], map: "device_secrets_device_idx")
  @@index([org_id], map: "device_secrets_org_idx")
