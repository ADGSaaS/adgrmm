  organization_id String   @db.Uuid
  name            String
  hint            String?
  subject         String   @default("")
  body            String   @default("")
  priority        String   @default("medium")
  custom_fields   Json     @default("{}")
  sort_order      Int      @default(0)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
}

/// What an administrator changed about a system email. Without a row the built-in wording is used.
model email_templates {
  organization_id String   @db.Uuid
  key             String
  subject         String
  body            String
  updated_by      String?  @db.Uuid
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@id([organization_id, key])
}

/// An address that gets a signed copy of chosen events (Administration > Integrations).
model webhook_endpoints {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String
  url             String
  secret          String
  events          String[]
  /// auto (from the address), adgrmm, slack, discord or teams
  format          String   @default("auto")
  enabled         Boolean  @default(true)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  deliveries      webhook_deliveries[]
}

/// One event for one webhook: waiting, delivered or given up on.
model webhook_deliveries {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpoint_id     String   @db.Uuid
  event           String
  payload         Json
  status          String   @default("pending")
  attempts        Int      @default(0)
  next_attempt_at DateTime @default(now()) @db.Timestamptz(6)
  response_status Int?
  last_error      String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  delivered_at    DateTime? @db.Timestamptz(6)
  endpoint        webhook_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)

  @@index([status, next_attempt_at])
  @@index([endpoint_id, created_at(sort: Desc)])
}

/// Internal knowledge base (help desk). Customer documentation lives in the separate docs app, not here.
model kb_categories {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String
  sort_order      Int           @default(0)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  articles        kb_articles[]
}

model kb_articles {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String    @db.Uuid
  category_id      String?   @db.Uuid
  title            String
  body             String    @default("")
  tags             String[]  @default([])
  status           String    @default("draft")
  customer_visible Boolean   @default(false)
  author_user_id   String?   @db.Uuid
  updated_by       String?   @db.Uuid
  version          Int       @default(1)
  view_count       Int       @default(0)
  helpful_count    Int       @default(0)
  unhelpful_count  Int       @default(0)
