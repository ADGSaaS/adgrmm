/// One row per device per day: how often it was seen online and how full its disks were, sampled every 15 minutes.
/// Availability and disk-space trends are worked out from these.
model device_daily {
  device_id         String   @db.Uuid
  day               DateTime @db.Date
  samples           Int      @default(0)
  online_samples    Int      @default(0)
  disk_free_pct_min Float?
  disk_total_bytes  BigInt?
  disk_free_bytes   BigInt?
  business_samples        Int      @default(0)
  business_online_samples Int      @default(0)
  devices           devices  @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@id([device_id, day])
  @@index([day])
}

