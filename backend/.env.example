# =============================================================================
# ADG RMM Backend Environment Configuration
# =============================================================================
#
# Copy this file to .env and replace placeholder values as appropriate:
#
#   cp .env.example .env
#
# Never commit your real .env file, passwords, API keys, JWT secrets,
# enrollment secrets, or other production credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=3001

# Enable or disable Swagger/OpenAPI documentation.
SWAGGER=false


# -----------------------------------------------------------------------------
# Public URLs / CORS
# -----------------------------------------------------------------------------

# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=https://console.example.com

# Primary browser origin allowed by deployments that use a single-origin value.
ALLOWED_ORIGIN=https://console.example.com

# Public URL where this backend is reachable.
PUBLIC_BASE_URL=https://api.example.com


# -----------------------------------------------------------------------------
# Authentication / Sessions
# -----------------------------------------------------------------------------

# HTTP cookie name used for ADG RMM authentication.
AUTH_COOKIE_NAME=adgrmm_session

# Parent domain used when sharing authentication between API and console.
# Example:
#   AUTH_COOKIE_DOMAIN=example.com
AUTH_COOKIE_DOMAIN=example.com

# Authentication cookie lifetime in milliseconds.
# Example below: 24 hours.
AUTH_COOKIE_MAX_AGE_MS=86400000

# Generate a long cryptographically-random value for production.
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# JWT expiration accepted by the application.
JWT_EXPIRES=24h

# Administrative API credential.
ADMIN_API_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Secret used for agent/device enrollment.
ENROLLMENT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET


# -----------------------------------------------------------------------------
# PostgreSQL / Prisma
# -----------------------------------------------------------------------------

# Main ADG RMM application database.
#
# Replace username, password, host, port, and database as appropriate.
DATABASE_URL=postgresql://adgrmm:CHANGE_ME@127.0.0.1:5432/adgrmm?schema=public

# true / false depending on the PostgreSQL deployment.
DATABASE_SSL=false

# Database pool sizing.
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0


# -----------------------------------------------------------------------------
# Local PostgreSQL Docker Configuration
# -----------------------------------------------------------------------------
#
# These values are primarily used with the provided PostgreSQL Docker setup.
# The password itself should be stored in POSTGRES_PASSWORD_FILE rather than
# committed to source control.
# -----------------------------------------------------------------------------

POSTGRES_USER=adgrmm
POSTGRES_DB=adgrmm
POSTGRES_PORT=5432

POSTGRES_PASSWORD_FILE=./.secrets/postgres_password


# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------

# Maximum avatar upload size in megabytes.
AVATAR_MAX_MB=5


# -----------------------------------------------------------------------------
# Email / IMAP
# -----------------------------------------------------------------------------

# Enables or disables background IMAP polling.
IMAP_POLL_ENABLED=false


# -----------------------------------------------------------------------------
# Agent Installer
# -----------------------------------------------------------------------------

# Public URL used as the base for generated/downloadable agent installers.
INSTALLER_BASE_URL=https://api.example.com

# Kill switch for agent self-update. Set to false to stop offering updates to agents; it is read
# on every request. Details: docs/agent-updates.md
AGENT_UPDATES_ENABLED=true

# Days of check results to keep. The newest result of each check is always kept.
CHECK_RUNS_RETENTION_DAYS=14

# Remote Console relay. Options and setup: docs/remote-console-turn.md
# TURN_PROVIDER=builtin|cloudflare|none
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_AUTH_SECRET=
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# TURN_STUN_URLS=

# Days of audit log entries to keep. Older entries are removed once a day.
AUDIT_RETENTION_DAYS=365
