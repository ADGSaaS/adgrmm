# Shared with the backend. Generate one with: openssl rand -hex 32
TURN_AUTH_SECRET=

# Any name for this relay, usually your domain.
TURN_REALM=turn.example.com

# The public IP address clients reach this relay on.
# Behind NAT, use public/private, for example 203.0.113.10/10.0.0.5
TURN_EXTERNAL_IP=

TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
