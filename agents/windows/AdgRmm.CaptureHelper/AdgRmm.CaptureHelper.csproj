<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>

    <!-- Opt out of Central Package Version Management -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <Nullable>enable</Nullable>
    <!-- The same source gives the same bytes on any machine, so a build can be checked against another. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>AdgRmm.CaptureHelper</AssemblyName>
    <RootNamespace>AdgRmm.CaptureHelper</RootNamespace>

    <!-- WinExe avoids a console window flash -->
    <OutputType>WinExe</OutputType>

    <!-- Ensure an .exe is produced (apphost) -->
    <UseAppHost>true</UseAppHost>

    <!-- Publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Force real single-file EXE output -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Nothing is unpacked: this starts for every session, and antivirus scans anything unpacked. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep only if your helper uses WMI -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

</Project>
